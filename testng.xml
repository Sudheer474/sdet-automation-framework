<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">



<suite name="SDET Automation Framework" parallel="classes" thread-count="1">
  <listeners>
    <listener class-name="com.sudheer.framework.listeners.TestListener"/>
    <listener class-name="com.sudheer.framework.listeners.RetryTransformer"/>
  </listeners>

  <test name="API Tests">
    <packages><package name="com.sudheer.framework.tests.api"/></packages>
  </test>

  <test name="UI Tests">
    <packages><package name="com.sudheer.framework.tests.ui"/></packages>
  </test>
</suite>
